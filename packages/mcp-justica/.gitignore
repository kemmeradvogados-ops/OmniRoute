__pycache__/
*.pyc
.venv/
.env
*.sqlite3
*.db
.pytest_cache/
*.egg-info/

# O pacote `.mcpb` e GERADO a partir de conector/ com `mcpb pack`. Versionar o
# zip faria conviverem duas verdades: a fonte e uma copia que envelhece em
# silencio, e quem instalasse a copia velha acharia que instalou a nova.
conector/*.mcpb

# Pasta de copias criada por engano DENTRO do pacote. Acontece quando um
# caminho do Windows (`G:\Meu Drive\...`) chega a uma maquina Linux: la a
# barra invertida nao separa pasta, entao o nome inteiro vira UM diretorio
# aqui dentro, e o que deveria ir para o Drive da banca fica versionado.
# Foi assim que `sistemas.json` entrou no repositorio publico (commit
# d2533222, removido depois). O conteudo era de teste, mas a proxima vez
# poderia ser de cliente.
G:*
# No Windows `:` e ilegal em nome de arquivo, entao o mesmo caminho
# aparece la com o nome deformado. Ignorar as duas formas.
G__/
G__*
