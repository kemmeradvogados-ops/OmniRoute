# Chave publica emitida pelo Departamento de Pesquisas Judiciarias do Conselho
# Nacional de Justica. Obtenha em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# NAO e segredo do escritorio, mas mantenha fora do controle de versao.
DATAJUD_API_KEY=

# Diretorio de estado (cache, snapshots, auditoria). Padrao: ~/.justica-mcp
JUSTICA_MCP_HOME=

# Inscricao na Ordem usada como chave padrao de monitoramento.
JUSTICA_OAB_NUMERO=218174
JUSTICA_OAB_UF=RJ

# NUNCA coloque senha de portal nem semente de segundo fator neste arquivo.
# Credenciais entram apenas na Fase 2, via cofre de segredos.

# ---------------------------------------------------------------------------
# Acesso autenticado aos portais (Fase 2). DESLIGADO por padrao.
#
# Ligar permite que o agente dispare autenticacao real no tribunal com a
# credencial do advogado. Cada consulta leva dezenas de segundos e consome uma
# tentativa; tentativas seguidas bloqueiam o acesso. Decisao do operador.
JUSTICA_ACESSO_AUTENTICADO=0

# Teto de tentativas de autenticacao por janela, para um laco de agente nao
# queimar as tentativas da conta. Padrao: 6 por 60 minutos.
# JUSTICA_TETO_TENTATIVAS=6
# JUSTICA_JANELA_TENTATIVAS_MIN=60

# Endereco e perfil de cada portal. Ficam aqui, e nao como parametro de
# ferramenta: o agente nao deve precisar saber o endereco nem ter como apontar
# a autenticacao para outro lugar.
# JUSTICA_PORTAL_TRF2_EPROC_URL=https://eproc.jfrj.jus.br/eproc/index.php
# JUSTICA_PORTAL_TRF2_EPROC_PERFIL=RJ168943

# Portais e processos de teste, um bloco por tribunal e sistema.
# O PROCESSO_TESTE e usado quando `consultar` roda sem --processo. Ele mora aqui,
# e NAO no codigo, porque e numero de processo de cliente: o repositorio e
# compartilhado, e numero em codigo versionado nao se apaga do historico.
# JUSTICA_PORTAL_TJRJ_PJE_URL=https://...
# JUSTICA_PORTAL_TJRJ_PJE_PROCESSO_TESTE=0000000-00.0000.0.00.0000
# JUSTICA_PORTAL_TJRJ_EPROC_URL=https://...
# JUSTICA_PORTAL_TJRJ_EPROC_PROCESSO_TESTE=0000000-00.0000.0.00.0000
# JUSTICA_PORTAL_TJRJ_DCP_URL=https://...
# JUSTICA_PORTAL_TJRJ_DCP_PROCESSO_TESTE=0000000-00.0000.0.00.0000
# JUSTICA_PORTAL_TJSP_ESAJ_URL=https://...
# JUSTICA_PORTAL_TJSP_ESAJ_PROCESSO_TESTE=0000000-00.0000.0.00.0000
# JUSTICA_PORTAL_TRT1_PJE_URL=https://...
# JUSTICA_PORTAL_TRT1_PJE_PROCESSO_TESTE=0000000-00.0000.0.00.0000

# Pasta onde ficam as copias dos processos. Aponte para a pasta do escritorio,
# tipicamente dentro do Google Drive sincronizado, para as copias entrarem no
# fluxo que a banca ja usa em vez de ficarem num canto que ninguem abre.
# JUSTICA_PASTA_COPIAS=G:\Meu Drive\4.Processos\Cópias

# Descarta o perfil do navegador a cada execucao. Desligado por padrao: com o
# perfil guardado, a liberacao do desafio "Confirme que e humano" obtida pelo
# operador deixa de ser jogada fora ao fechar o programa. Ligue so se preferir
# refazer o desafio toda vez.
# JUSTICA_NAVEGADOR_EFEMERO=1

# Caminho de um Chrome ja instalado, para dispensar o download do navegador.
# JUSTICA_CHROMIUM=C:\caminho\para\chrome.exe

# NUNCA coloque senha de portal nem semente de segundo fator neste arquivo.
# Elas vivem no cofre do sistema, carregado por `justica-credenciais`.
